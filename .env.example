# API Base URL (Change to production backend URL when deploying, e.g. https://api.gram2city.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Identity Services (Direct Google OAuth 2.0)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Payment Gateway (Stripe Public Key)
NEXT_PUBLIC_STRIPE_PK=pk_test_your_stripe_public_key

# Image Hosting (ImgBB API Key for file/avatar uploads)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
